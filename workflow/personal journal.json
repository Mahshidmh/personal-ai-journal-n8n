        "promptType": "define",
        "text": "=Analyze the emotional content of this journal entry.\n\nJournal:\n{{ $('extract text').item.json.text }}\n\nIdentify:\n1. Overall sentiment (positive, negative, neutral, or mixed)\n2. Primary emotions\n3. Emotional intensity from 1 to 10\n4. Brief explanation based on the text\n\nReturn the result in valid JSON only:\n\n{\n  \"sentiment\": \"\",\n  \"emotions\": [],\n  \"intensity\": 0,\n  \"explanation\": \"\"\n}",
        "batching": {}
      },
