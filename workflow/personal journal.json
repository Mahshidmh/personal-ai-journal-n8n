    {
      "parameters": {
        "jsCode": "const files = $input.all();\n\nconst validFiles = files.filter(item => {\n  const name = item.json.fileName;\n  return /^\\d{4}-\\d{2}-\\d{2}\\.txt$/.test(name);\n});\n\nif (validFiles.length === 0) {\n  throw new Error('No valid journal files found.');\n}\n\nvalidFiles.sort((a, b) => {\n  return b.json.fileName.localeCompare(a.json.fileName);\n});\n\nreturn [validFiles[0]];"
      },
